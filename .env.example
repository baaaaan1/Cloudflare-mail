# ============================================================
# Cloudflare Email Panel - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the required values.
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------
# Authentication (Password)
# ------------------------------------------------------------
# Password used to log in to the panel. Set this to anything you want.
# Falls back to ADMIN_PASSWORD if APP_PASSWORD is not set.
APP_PASSWORD=change-me-now-please

# Random secret used to sign session cookies. If omitted, a stable
# secret is generated once and persisted in DATA_DIR/auth-secret.txt.
# AUTH_SECRET=please-set-a-long-random-string

# REST API keys are created from the panel (API docs -> API keys).
# Only a SHA-256 hash is stored, in DATA_DIR/api-keys.json. Send a key as
#   Authorization: Bearer cfm_...
# or
#   X-API-Key: cfm_...

# Directory where the generated auth secret is stored.
# Persist this with a Docker volume so sessions survive rebuilds.
DATA_DIR=/app/data

# ------------------------------------------------------------
# Cloudflare Turnstile (login captcha, optional)
# ------------------------------------------------------------
# Set TURNSTILE_ENABLED=true to protect the login form with Turnstile.
# Both keys are required; if either is missing the captcha stays disabled.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------
# Domain (required for Docker/Caddy deployments)
# Caddy uses this to auto-issue a Let's Encrypt TLS certificate.
# Not needed if you run `node server.js` directly (plain HTTP).
# ------------------------------------------------------------
CADDY_DOMAIN=mail.example.com

# ------------------------------------------------------------
# Cloudflare Credentials (required)
# ------------------------------------------------------------
# API Token — create at https://dash.cloudflare.com/profile/api-tokens
# Required permissions:
#   - Account > D1 > Read (for inbox)
#   - Account > Workers Scripts > Edit (for inbox worker)
#   - Zone   > Email Routing > Edit
CLOUDFLARE_API_TOKEN=

# Account ID — find at https://dash.cloudflare.com/ → any zone → right sidebar
CLOUDFLARE_ACCOUNT_ID=

# D1 Database ID — only needed if you want the Inbox feature.
# Create a D1 database in the Cloudflare dashboard, then paste its ID here.
CLOUDFLARE_D1_DATABASE_ID=

# Optional: name of the worker that receives ALL incoming mail (catch-all).
# Defaults to inbox-worker. Used by scripts/cf-setup.mjs and the panel.
# EMAIL_WORKER_NAME=inbox-worker

# Optional: D1 database name created/reused by scripts/cf-setup.mjs.
# EMAIL_DB_NAME=email_db
