PORT=3000
CADDY_DOMAIN=mail.ayaneo.my.id
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Zone ID removed — token now uses Zone Resources: All Zones
CLOUDFLARE_D1_DATABASE_ID=
# Option A (recommended): pre-computed scrypt hash + salt
PASSWORD_HASH=
PASSWORD_SALT=
# Option B: plain password — PASSWORD_SALT/PASSWORD_HASH are generated automatically at startup
PASSWORD=
# Optional: token for scripted/remote API access (Authorization: Bearer <token> or X-API-Key)
# Generate one any way you like, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_TOKEN=
