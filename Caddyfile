{
	# No local admin API: config is managed only through this Caddyfile.
	admin off

	servers {
		timeouts {
			read_header 10s
			idle 120s
		}
	}
}

# DOMAIN is injected by docker-compose.yml; the fallback is only an example.
{$DOMAIN:mail.example.com} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-server
	}

	# The app only accepts small JSON/form bodies (200 KB limit in Express).
	request_body {
		max_size 1MB
	}

	reverse_proxy panel:3000
}
